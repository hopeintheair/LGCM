# Manually entering data from Table 5.7
berkeley <- data.frame(
Department = rep(1:6, each = 4),
Gender = rep(c("Male", "Male", "Female", "Female"), 6),
Admitted = rep(c("Yes", "No", "Yes", "No"), 6),
Count = c(
# Dept 1
512, 313, 89, 19,
# Dept 2
353, 207, 17, 8,
# Dept 3
120, 205, 202, 391,
# Dept 4
138, 279, 131, 244,
# Dept 5
53, 138, 94, 299,
# Dept 6
22, 351, 24, 317
)
)
# Reshaping it for logistic regression
# Create binary response (1 = admitted, 0 = not admitted)
berkeley_long <- berkeley %>%
mutate(y = ifelse(Admitted == "Yes", 1, 0)) %>%
uncount(Count)
# Reshaping it for logistic regression
# Create binary response (1 = admitted, 0 = not admitted)
berkeley_long <- berkeley %>%
dplyr::mutate(y = ifelse(Admitted == "Yes", 1, 0)) %>%
tidyr::uncount(Count)
# Converting to factors
berkeley_long$Department_f <- factor(berkeley_long$Department)
berkeley_long$Gender_f <- factor(berkeley_long$Gender, levels = c("Female", "Male"))
# Part (a)
berkeley_dept <- glm(y ~ Department_f, data = berkeley_long, family = binomial)
summary(berkeley_dept)
rstandard(berkeley_dept, type = 'pearson')
# Goodness of fit test
berkeley_grouped <- berkeley %>%group_by(Department) %>%
summarize(
n = sum(Count),
admitted = sum(Count[Admitted == "Yes"])
)
# Goodness of fit test
berkeley_grouped <- berkeley %>%
dplyr::group_by(Department) %>%
dplyr::summarize(
n = sum(Count),
admitted = sum(Count[Admitted == "Yes"])
)
# Fitting to grouped data for GOF test
berkeley_dept_grouped <- glm(cbind(admitted, n - admitted) ~ factor(Department),
data = berkeley_grouped, family = binomial)
# Deviance goodness of fit
G2 <- berkeley_dept_grouped$deviance
df_gof <- berkeley_dept_grouped$df.residual
p_gof <- 1 - pchisq(G2, df_gof)
p_gof
df_gof
