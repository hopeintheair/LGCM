latent_5i5_small_good_ST_200_basic <- run5i5t(
nrep = 1, model = "latent",
k1 = 1, k2 = 0.125,
phi1 = 1, phi2 = 0.32, phi12 = 0.13,
sigma_mu = 0.78,
psi1 = 1.097, psi2 = .98, psi3 = .95, psi4 = .93, psi5 = .91,
inv.type = c("strict"),
tau = .10, lambda = .40, sd.lambda = 0.0,
nsize = 2000000, auto_var1 = FALSE, rho = 0, seed = 3201
)
View(latent_5i5_small_good_ST_200_basic)
