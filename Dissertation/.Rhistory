salary_s      = salary / 1000,
salary_adj_s  = salary_adj / 1000,
salary_l      = log1p(salary),
salary_adj_l  = log1p(salary_adj)) |>
dplyr::select(id_whole, sampling_id, race, education, weight, year, time, salary, salary_s, salary_l,
salary_adj, salary_adj_s, salary_adj_l,
YN_disable, NO_disable, Care, Carehours, Care_out, Care_out_hours,
marital, sex.x, birth_year.x)
empl_df <- df |>
dplyr::filter(id_whole %in% ids_both) |>
dplyr::mutate(
salary_s      = salary / 1000,
salary_adj_s  = salary_adj / 1000,
salary_l      = log1p(salary),
salary_adj_l  = log1p(salary_adj)) |>
dplyr::select(id_whole, sampling_id, race, education, weight, year, time, salary, salary_s, salary_l,
salary_adj, salary_adj_s, salary_adj_l,
YN_disable, NO_disable, Care, Carehours, Care_out, Care_out_hours,
marital, sex.x, birth_year.x)
empl_df_cp <- empl_df
empl_df_cp[] <- lapply(empl_df_cp, function(x) {
replace(x, x %in% c(-1,-2,-3,-4), NA)
})
empl_df_cp2 <- empl_df_cp %>%
mutate(
needcare = case_when(
YN_disable == "No" ~ "NoNEED",
YN_disable == "Yes" & Care == 1 ~ "NEED & YesCARE",
YN_disable == "Yes" & Care == 0 ~ "NEED & NoCARE",
TRUE ~ NA_character_
),
needcare = factor(needcare,
levels = c("NoNEED","NEED & NoCARE","NEED & YesCARE"))
) %>%
filter(!is.na(needcare))
table(empl_df_cp2$needcare)
## Care_out_v2: -4 to NA for sensitivity analysis
careout_alt_long <- rq2_df2 %>%
dplyr::select(id_whole, Care_out_08, Care_out_10, Care_out_12, Care_out_14,
Care_out_16, Care_out_18, Care_out_20, Care_out_22) %>%
tidyr::pivot_longer(
cols          = dplyr::starts_with("Care_out_"),
names_to      = "yy",
names_pattern = "Care_out_(\\d+)",
values_to     = "raw"
) %>%
dplyr::mutate(
year            = 2000L + as.integer(yy),
Care_out_num_NA = dplyr::if_else(raw < 0, NA_real_, as.numeric(raw))
) %>%
dplyr::select(id_whole, year, Care_out_num_NA)
# add 'Care_out_v2'
empl_df_cp2 <- empl_df_cp2 %>%
dplyr::left_join(careout_alt_long, by = c("id_whole", "year"))
plot_df <- empl_df_cp2 %>%
group_by(year) %>%
summarise(
Nominal  = mean(salary,     na.rm = TRUE),
Adjusted = mean(salary_adj, na.rm = TRUE),
.groups  = "drop"
) %>%
pivot_longer(c(Nominal, Adjusted),
names_to = "type", values_to = "mean_salary")
ggplot(plot_df, aes(year, mean_salary, color = type)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
scale_x_continuous(breaks = unique(plot_df$year)) +
scale_y_continuous(labels = scales::comma) +
scale_color_manual(values = c(Nominal = "grey50", Adjusted = "steelblue")) +
labs(title = "Mean salary by year: nominal vs. 2022-adjusted",
x = "Year", y = "Mean salary (USD)", color = NULL) +
theme_minimal(base_size = 13) +
theme(legend.position = "top")
