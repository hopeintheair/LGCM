# (2) ARI — 라벨번호와 무관하게 분류 일치도 (1=완전일치)
adjustedRandIndex(cmp$c_real, cmp$c_nom)
install.packages("mclust")
library(mclust)
# (2) ARI — 라벨번호와 무관하게 분류 일치도 (1=완전일치)
